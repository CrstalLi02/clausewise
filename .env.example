# ============================================================
# Clausewise · Environment variable template
# Copy to .env and fill in real secrets: cp .env.example .env
# ============================================================

# ---------- LLM: DeepSeek (primary chat model) ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT=60

# ---------- Relay service: non-DeepSeek models (bge etc., OpenAI-compatible) ----------
RELAY_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RELAY_BASE_URL=https://yunwu.ai/v1
RELAY_MODEL=gpt-5.5

# ---------- Embedding (vector model, via the relay service) ----------
# provider: relay = via the relay service; local = local sentence-transformers; hash = offline deterministic vectors (dev/test only)
# Note: this relay service does not provide bge-m3 embedding; use text-embedding-3-large (3072) / text-embedding-3-small (1536)
EMBEDDING_PROVIDER=relay
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# ---------- Storage ----------
STORAGE_MODE=mongo            # mongo | memory
MONGO_INITDB_ROOT_USERNAME=clausewise_admin   # MongoDB root account (used for compose initialization)
MONGO_INITDB_ROOT_PASSWORD=change-me-strong-mongo-password
REDIS_PASSWORD=change-me-strong-redis-password   # Redis requirepass
MONGODB_URI=mongodb://clausewise_admin:change-me-strong-mongo-password@localhost:27017/clausewise?authSource=admin
MONGODB_DB=clausewise
REDIS_ADDR=redis://:change-me-strong-redis-password@localhost:6379
REDIS_DB=0

# ---------- Retrieval ----------
VECTOR_BACKEND=memory         # memory | chroma | milvus
HYBRID_TOPK=5
BM25_TOP=20
VECTOR_TOP=20
RERANKER_ENABLED=true         # Whether to enable reranking (bge reranker via the relay service)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- Service ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Explicitly list allowed frontend origins (replace with real domains in production; wildcards are not allowed for credentialed requests)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- pi agent service (deep Harness + Loop integration) ----------
PI_AGENT_ENABLED=true
PI_AGENT_URL=http://localhost:8100   # Inside Docker: http://pi-agent:8100
INTERNAL_API_TOKEN=change-me-strong-random-token   # Shared token for internal endpoints (must match the backend; never expose)

# ---------- Upload limits ----------
MAX_UPLOAD_MB=20                # Maximum document upload size (MB)

# ---------- Login rate limiting ----------
LOGIN_MAX_ATTEMPTS=5            # Maximum failed logins (within the window)
LOGIN_WINDOW_SECONDS=300        # Rate-limit window (seconds)

# ---------- Loop evolution ----------
LOOP_ENABLED=true
SKILL_MIN_CLUSTER=20          # Skill mining: minimum occurrences of the same question pattern within a 7-day window
SKILL_SANDBOX_MIN_SUCCESS=0.85
HOOK_HIGH_CONFIDENCE=0.9      # Auto-apply threshold for high confidence (human-on-the-loop / out-of-the-loop)
LOOP_PHASE=human_in_loop      # human_in_loop | human_on_loop | human_out_of_loop (start at Phase 1 and exit progressively)

# ---------- Authentication ----------
AUTH_SECRET=change-me-strong-random-secret   # Token signing secret (must be a strong random value in production)
AUTH_TOKEN_TTL_HOURS=24
SEED_DEMO_USERS=true           # Demo account switch (student/student123, admin/admin123); must be false in production

# ---------- Human review Loop (progressive department exit) ----------
REVIEW_QUESTION_COUNT=3         # Number of test questions auto-generated after a new document is ingested
REVIEW_ACCURACY_THRESHOLD=0.8   # Human review is disabled once accuracy exceeds this threshold (human exits the Loop)
REVIEW_MIN_SAMPLES=5            # Minimum number of review samples required to reach the threshold (accumulated feedback)
