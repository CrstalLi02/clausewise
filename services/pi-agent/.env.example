# pi-agent service environment variables (injected by compose in Docker; copy to .env locally)
PORT=8100
HOST=0.0.0.0
BACKEND_URL=http://localhost:8000
# Shared token for calling the backend /internal/* (must match the backend INTERNAL_API_TOKEN)
INTERNAL_API_TOKEN=change-me-strong-random-token

# DeepSeek (primary chat model)
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Relay service (non-DeepSeek models)
RELAY_API_KEY=sk-xxxxxxxx
RELAY_BASE_URL=https://yunwu.ai/v1
RELAY_MODEL=gpt-5.5

# Loop
LOOP_ENABLED=true
LOOP_PHASE=human_on_loop
HOOK_HIGH_CONFIDENCE=0.9
