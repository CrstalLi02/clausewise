# Copy to secrets.yaml, fill in real secrets, then apply
# Note: all secrets are placeholders; replace them with strong random values before deploying (see the values generated in the root .env)
apiVersion: v1
kind: Secret
metadata:
  name: clausewise-secrets
  namespace: clausewise
type: Opaque
stringData:
  DEEPSEEK_API_KEY: "sk-xxxxxxxx"
  RELAY_API_KEY: "sk-xxxxxxxx"
  # Token signing secret and internal endpoint token (strong random; must match between backend and pi-agent)
  AUTH_SECRET: "change-me-strong-random-secret"
  INTERNAL_API_TOKEN: "change-me-strong-random-token"
  # Database credentials (mongodb init root account; redis requirepass)
  MONGO_INITDB_ROOT_USERNAME: "clausewise_admin"
  MONGO_INITDB_ROOT_PASSWORD: "change-me-strong-mongo-password"
  REDIS_PASSWORD: "change-me-strong-redis-password"
  MONGODB_URI: "mongodb://clausewise_admin:change-me-strong-mongo-password@mongodb:27017/clausewise?authSource=admin"
  REDIS_ADDR: "redis://:change-me-strong-redis-password@redis:6379"
